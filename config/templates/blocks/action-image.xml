<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd"
>
    <key>action-image</key>
    <meta>
        <title>Image</title>
    </meta>
    <properties>
        <property name="name" type="text_line" mandatory="true" colspan="4">
            <meta>
                <title>Name</title>
            </meta>
        </property>
        <property name="value" type="single_media_selection" mandatory="true" colspan="8">
            <meta>
                <title>sulu.image</title>
            </meta>
            <params>
                <param name="types" value="image" />
            </params>
        </property>
    </properties>
</template>
