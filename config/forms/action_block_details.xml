<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>action_block_details</key>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title>sulu_admin.title</title>
            </meta>
            <params>
                <param name="required" value="true"/>
            </params>
        </property>
        
        <property name="action" type="single_select" mandatory="true">
            <meta>
                <title>Action</title>
            </meta>
            <params>
                <param name="action " type="expression" value="service('PERSPEQTIVE\\SuluActionBlockBundle\\Content\\Select\\ActionSelect').getValues()"/>
            </params>
        </property>
    </properties>
</form>
